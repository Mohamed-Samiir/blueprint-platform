{
  "name": "@blueprint-platform/components",
  "version": "0.1.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "generators": "./generators.json",
  "files": [
    "dist",
    "generators.json",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./generators.json": "./generators.json",
    "./generators/ui": {
      "@blueprint-platform/source": "./src/generators/ui/ui.ts",
      "types": "./dist/generators/ui/ui.d.ts",
      "require": "./dist/generators/ui/ui.js",
      "default": "./dist/generators/ui/ui.js"
    },
    ".": {
      "@blueprint-platform/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/components/dist",
          "main": "packages/components/src/index.ts",
          "tsConfig": "packages/components/tsconfig.lib.json",
          "rootDir": "packages/components/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/components/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/components/src",
              "glob": "**/*.d.ts",
              "output": "."
            },
            {
              "input": "./packages/components/src/generators/ui",
              "glob": "schema.json",
              "output": "./generators/ui"
            },
            {
              "input": "./packages/components/src/generators/ui/files/shared/ui",
              "glob": "**/*.ts",
              "output": "./generators/ui/files/shared/ui"
            }
          ]
        }
      }
    }
  },
  "dependencies": {
    "@nx/devkit": "23.1.1",
    "tslib": "^2.3.0",
    "@blueprint-platform/generator-kit": "^0.1.0"
  }
}
