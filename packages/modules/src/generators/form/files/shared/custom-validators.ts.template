import type { AbstractControl, ValidationErrors, ValidatorFn } from '@angular/forms';

/**
 * Validators for the constraints Angular has no built-in for — date bounds,
 * selection-count bounds, and file constraints. Generated by
 * `nx g @blueprint-platform/modules:form` and shared by every generated form;
 * you own this file. Each returns its error under its own key (e.g.
 * `{ minDate: true }`), which is what the generated `<hlm-field-error
 * validator="minDate">` matches.
 *
 * Every validator treats an empty value (`null`, `''`, `[]`) as valid —
 * pair with `required` to forbid emptiness, same convention as Angular's own.
 */

/** Date | ISO/date string | 'HH:mm' time string → a comparable number, or null when empty/unparseable. */
function toComparable(value: unknown): number | null {
  if (value === null || value === undefined || value === '') return null;
  if (value instanceof Date) return value.getTime();
  if (typeof value === 'string') {
    const time = /^(\d{1,2}):(\d{2})$/.exec(value);
    if (time) return Number(time[1]) * 60 + Number(time[2]);
    const parsed = Date.parse(value);
    return Number.isNaN(parsed) ? null : parsed;
  }
  return null;
}

const DAY_MS = 24 * 60 * 60 * 1000;

export function minDateValidator(min: string): ValidatorFn {
  return (control: AbstractControl): ValidationErrors | null => {
    const value = toComparable(control.value);
    const bound = toComparable(min);
    if (value === null || bound === null) return null;
    return value < bound ? { minDate: { min, actual: control.value } } : null;
  };
}

export function maxDateValidator(max: string): ValidatorFn {
  return (control: AbstractControl): ValidationErrors | null => {
    const value = toComparable(control.value);
    const bound = toComparable(max);
    if (value === null || bound === null) return null;
    return value > bound ? { maxDate: { max, actual: control.value } } : null;
  };
}

/** A date-range control's value is a `[start, end]` tuple. */
function rangeDays(value: unknown): number | null {
  if (!Array.isArray(value)) return null;
  const start = toComparable(value[0]);
  const end = toComparable(value[1]);
  if (start === null || end === null) return null;
  return Math.round((end - start) / DAY_MS) + 1;
}

export function minRangeDaysValidator(min: number): ValidatorFn {
  return (control: AbstractControl): ValidationErrors | null => {
    const days = rangeDays(control.value);
    if (days === null) return null;
    return days < min ? { minRangeDays: { min, actual: days } } : null;
  };
}

export function maxRangeDaysValidator(max: number): ValidatorFn {
  return (control: AbstractControl): ValidationErrors | null => {
    const days = rangeDays(control.value);
    if (days === null) return null;
    return days > max ? { maxRangeDays: { max, actual: days } } : null;
  };
}

export function minSelectedValidator(min: number): ValidatorFn {
  return (control: AbstractControl): ValidationErrors | null => {
    const value = control.value;
    if (!Array.isArray(value) || value.length === 0) return null;
    return value.length < min ? { minSelected: { min, actual: value.length } } : null;
  };
}

export function maxSelectedValidator(max: number): ValidatorFn {
  return (control: AbstractControl): ValidationErrors | null => {
    const value = control.value;
    if (!Array.isArray(value)) return null;
    return value.length > max ? { maxSelected: { max, actual: value.length } } : null;
  };
}

/** An attachment control's value is a `File[]` (or `null` when nothing is attached). */
function asFiles(value: unknown): File[] {
  return Array.isArray(value) ? (value as File[]) : [];
}

export function maxFileSizeValidator(maxMb: number): ValidatorFn {
  return (control: AbstractControl): ValidationErrors | null => {
    const tooBig = asFiles(control.value).find((f) => f.size > maxMb * 1024 * 1024);
    return tooBig ? { maxFileSizeMb: { max: maxMb, file: tooBig.name } } : null;
  };
}

export function allowedExtensionsValidator(extensions: string[]): ValidatorFn {
  const allowed = extensions.map((e) => e.replace(/^\./, '').toLowerCase());
  return (control: AbstractControl): ValidationErrors | null => {
    const bad = asFiles(control.value).find((f) => {
      const ext = f.name.includes('.') ? f.name.split('.').pop()!.toLowerCase() : '';
      return !allowed.includes(ext);
    });
    return bad ? { allowedExtensions: { allowed, file: bad.name } } : null;
  };
}

export function maxFilesValidator(max: number): ValidatorFn {
  return (control: AbstractControl): ValidationErrors | null => {
    const files = asFiles(control.value);
    return files.length > max ? { maxFiles: { max, actual: files.length } } : null;
  };
}
