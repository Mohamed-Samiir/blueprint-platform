{
  "name": "@blueprint-platform/modules",
  "version": "0.1.6",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "generators": "./generators.json",
  "files": [
    "dist",
    "generators.json",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./generators.json": "./generators.json",
    ".": {
      "@blueprint-platform/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/modules/dist",
          "main": "packages/modules/src/index.ts",
          "tsConfig": "packages/modules/tsconfig.lib.json",
          "rootDir": "packages/modules/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/modules/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/modules/src",
              "glob": "**/*.d.ts",
              "output": "."
            },
            {
              "input": "./packages/modules/src/generators/auth",
              "glob": "schema.json",
              "output": "./generators/auth"
            },
            {
              "input": "./packages/modules/src/generators/auth/files/core",
              "glob": "**/*.ts",
              "output": "./generators/auth/files/core"
            },
            {
              "input": "./packages/modules/src/generators/auth/files/features",
              "glob": "**/*.ts",
              "output": "./generators/auth/files/features"
            },
            {
              "input": "./packages/modules/src/generators/rbac",
              "glob": "schema.json",
              "output": "./generators/rbac"
            },
            {
              "input": "./packages/modules/src/generators/rbac/files/core",
              "glob": "**/*.ts",
              "output": "./generators/rbac/files/core"
            },
            {
              "input": "./packages/modules/src/generators/rbac/files/features",
              "glob": "**/*.ts",
              "output": "./generators/rbac/files/features"
            },
            {
              "input": "./packages/modules/src/generators/user-management",
              "glob": "schema.json",
              "output": "./generators/user-management"
            },
            {
              "input": "./packages/modules/src/generators/user-management/files/core",
              "glob": "**/*.ts",
              "output": "./generators/user-management/files/core"
            },
            {
              "input": "./packages/modules/src/generators/user-management/files/features",
              "glob": "**/*.ts",
              "output": "./generators/user-management/files/features"
            }
          ]
        }
      }
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "@nx/devkit": "23.1.1",
    "@blueprint-platform/foundation": "^0.1.26",
    "@blueprint-platform/components": "^0.1.3",
    "@blueprint-platform/generator-kit": "^0.1.3"
  }
}