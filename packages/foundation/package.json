{
  "name": "@blueprint-platform/foundation",
  "version": "0.1.11",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "generators": "./generators.json",
  "files": [
    "dist",
    "generators.json",
    "compatibility.json",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./generators.json": "./generators.json",
    ".": {
      "@blueprint-platform/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/foundation/dist",
          "main": "packages/foundation/src/index.ts",
          "tsConfig": "packages/foundation/tsconfig.lib.json",
          "rootDir": "packages/foundation/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/foundation/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/foundation/src",
              "glob": "**/*.d.ts",
              "output": "."
            },
            {
              "input": "./packages/foundation/src/generators/preset",
              "glob": "schema.json",
              "output": "./generators/preset"
            },
            {
              "input": "./packages/foundation/src/generators/preset/files/shared/ui",
              "glob": "**/*.ts",
              "output": "./generators/preset/files/shared/ui"
            },
            {
              "input": "./packages/foundation/src/generators/preset/files/layout",
              "glob": "**/*.ts",
              "output": "./generators/preset/files/layout"
            },
            "./packages/foundation/compatibility.json"
          ]
        }
      }
    }
  },
  "dependencies": {
    "@nx/devkit": "23.1.1",
    "tslib": "^2.3.0",
    "@nx/angular": "23.1.1",
    "ts-morph": "^28.0.0"
  }
}
