{
  "name": "foundation",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/foundation/dist",
        "main": "packages/foundation/src/index.ts",
        "tsConfig": "packages/foundation/tsconfig.lib.json",
        "rootDir": "packages/foundation/src",
        "generatePackageJson": false,
        "assets": [
          "packages/foundation/*.md",
          "packages/foundation/compatibility.json"
        ]
      }
    }
  },
  "sourceRoot": "packages/foundation/src",
  "projectType": "library"
}
