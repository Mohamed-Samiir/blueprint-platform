{
  "$schema": "https://json-schema.org/schema",
  "cli": "nx",
  "$id": "BlueprintFoundationPreset",
  "title": "Blueprint Foundation Preset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "App name"
    },
    "palette": {
      "type": "string",
      "default": "default"
    },
    "rtl": {
      "type": "boolean",
      "default": false
    },
    "labelPosition": {
      "type": "string",
      "enum": [
        "floating",
        "inline",
        "top"
      ],
      "default": "floating"
    },
    "layout": {
      "type": "string",
      "enum": [
        "sidebar-shell",
        "floating-shell",
        "inset-shell",
        "topbar-shell",
        "none"
      ],
      "default": "none"
    },
    "showThemeSwitcher": {
      "type": "boolean",
      "default": true
    },
    "showLanguageSwitcher": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}