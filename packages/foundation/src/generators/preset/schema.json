{
  "$schema": "https://json-schema.org/schema",
  "cli": "nx",
  "$id": "BlueprintFoundationPreset",
  "title": "Blueprint Foundation Preset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "App name"
    },
    "palette": {
      "type": "string",
      "default": "default"
    },
    "rtl": {
      "type": "boolean",
      "default": false
    },
    "layout": {
      "type": "string",
      "enum": [
        "sidebar-shell",
        "floating-shell",
        "inset-shell",
        "topbar-shell",
        "none"
      ],
      "default": "none"
    },
    "showThemeSwitcher": {
      "type": "boolean",
      "default": true
    },
    "showLanguageSwitcher": {
      "type": "boolean",
      "default": true
    },
    "languages": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["en", "ar"],
      "description": "Language codes to scaffold i18n for. Must exist in the generator's LANGUAGE_REGISTRY. First entry is the default/fallback."
    },
    "apiUrl": {
      "type": "string",
      "default": "",
      "description": "API origin only (scheme + host + port, no path) — e.g. http://10.1.21.26:8100"
    },
    "appVersion": {
      "type": "string",
      "default": "0.1.0"
    }
  },
  "required": [
    "name"
  ]
}